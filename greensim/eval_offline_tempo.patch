+def _planned_tempo(pred_abs: np.ndarray, true_abs: np.ndarray, mask: np.ndarray, j0: int = 2, j1: int = 17,
+                   moving: float = 0.15) -> dict:
+    """Offline tempo proxy: how far the plan travels over rows j0..j1 (0.5 s at 30 Hz) relative to
+    the demonstration, on frames where the demonstration is moving (> `moving` rad/s per group).
+    1.0 = the plan moves as fast as the demo; open-loop error is blind to this number."""
+    out = {}
+    dt = (j1 - j0) / 30.0
+    for name, sl in MODEL_GROUPS.items():
+        m = mask[:, sl].any(1)
+        if not m.any():
+            continue
+        dp = np.linalg.norm((pred_abs[:, j1, sl] - pred_abs[:, j0, sl]) * mask[:, sl], axis=1)
+        dd = np.linalg.norm((true_abs[:, j1, sl] - true_abs[:, j0, sl]) * mask[:, sl], axis=1)
+        sel = m & (dd / dt > moving)
+        if sel.sum() < 10:
+            continue
+        out[name] = {"plan_over_demo": float(dp[sel].sum() / dd[sel].sum()),
+                     "median_ratio": float(np.median(dp[sel] / dd[sel])), "frames": int(sel.sum())}
+    return out
+
+
+FINGERS = np.r_[34:40, 42:48]   # model layout: left fingers 34-39, right fingers 42-47
+
+
+def _finger_events(chunks: np.ndarray, thr: float = 0.01, window: int = 10) -> dict:
+    """What the adaptive-speed patch would see in these chunks: rows where any finger moves
+    more than `thr` rad between neighbouring rows (= a grasp/release event), and the share of rows
+    kept at 1x speed (within +-window rows of an event). On demonstrations the patch assumes
+    10-20 % of frames; on sampled plans jitter can flag almost everything."""
+    travel = np.abs(np.diff(chunks[:, :, FINGERS], axis=1)).max(-1)        # (N, H-1)
+    ev = travel > thr
+    slow = np.zeros(chunks.shape[:2], bool)
+    for j in np.argwhere(ev):
+        slow[j[0], max(0, j[1] + 1 - window): j[1] + 2 + window] = True
+    return {"rows_flagged": float(ev.mean()), "rows_kept_slow": float(slow.mean()),
+            "median_row_travel": float(np.median(travel))}
+
+
